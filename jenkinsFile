pipeline {

    agent any

    stages {

        stage('Install') {
            agent {
                docker {
                    image 'cypress/included:latest'
                    args '-u root --entrypoint='
                    reuseNode true
                }
            }

            steps {
                sh 'npm ci'
                sh 'npx cypress run'

            }
        }
    }

    post {
        always {
            allure([
                results: [[path: 'allure-results']]
            ])
        }
    }
}