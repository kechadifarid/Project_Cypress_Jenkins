pipeline {
                agent{
                docker{
                    image 'cypress/included:latest'
                    args '-u root --entrypoint='
                }
            }

    stages {
        stage('Install') {
            steps {
                sh 'npm ci'
            }
        }

        stage('Tests') {
            steps {
                sh 'npx cypress run'
            }
        }
    }
    post {
        always {
            allure([
                results: [[path: 'allure-results']]
            ])
        }
    }
}